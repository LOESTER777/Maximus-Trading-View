{
  "compilerOptions": {
    // ── Alvo ────────────────────────────────────────────────────────────────
    // ES2017 e o alvo da origem (Trading/frontend). Manter igual evita que o
    // downlevel do TypeScript altere o comportamento de codigo numerico que ja
    // foi medido em bancada (a BookmapPrimitive cronometra a si mesma).
    "target": "ES2017",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // ── Por que NodeNext e nao Bundler ──────────────────────────────────────
    // A origem e um app Next.js e compila com `moduleResolution: "Bundler"`,
    // que admite import relativo SEM extensao. Uma BIBLIOTECA nao pode assumir
    // bundler: o `dist/` emitido assim quebra com `ERR_MODULE_NOT_FOUND` no Node
    // ESM — medido, nao suposto. E SSR do Next, teste em Node puro e ferramenta
    // de linha de comando todos passam pelo Node.
    //
    // NodeNext exige `.js` no especificador relativo (ver
    // `scripts/add-esm-extensions.mjs`, que aplica e verifica isso). O custo e
    // essa exigencia; o ganho e um pacote consumivel por Node, Vite, Next,
    // webpack e Bun sem adaptador.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // ── Rigor ───────────────────────────────────────────────────────────────
    // `noUncheckedIndexedAccess` NAO e opcional aqui: o codigo copiado foi
    // escrito sob essa flag (ha guardas de `undefined` em acesso indexado por
    // toda parte). Desligar nao quebraria a compilacao, mas removeria a rede
    // que justifica aquelas guardas existirem.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // ── Emissao de biblioteca ───────────────────────────────────────────────
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false
  }
}
