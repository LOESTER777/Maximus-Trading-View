{
  "name": "@robustus/charts-react",
  "version": "0.1.0",
  "description": "Ligacao React fina para o motor. O motor nao sabe que React existe; este pacote e o unico que sabe.",
  "license": "UNLICENSED",
  "author": "Loester Rodrigo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOESTER777/Maximus-Trading-View.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/**/__bench__/**",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@robustus/charts-alerts": "^0.1.0",
    "@robustus/charts-drawings": "^0.1.0",
    "@robustus/charts-engine": "^0.1.0",
    "@robustus/charts-replay": "^0.1.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
