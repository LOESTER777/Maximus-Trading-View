{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // ⚠️ O pacote de replay compila SEM DOM. Isso e possivel porque o avanco
    // automatico entra por um `TimerLike` INJETADO (ver replay-controller.core):
    // o codigo nunca referencia `setInterval` global, `window` nem nada do
    // ambiente. A `lib` sem DOM e a barreira mecanica que faz um relogio global
    // acidental virar erro de compilacao em vez de dependencia de ambiente
    // escondida. O nucleo e puro; o wrapper so guarda o timer que recebeu.
    "lib": ["ES2020"],
    "types": []
  },
  // Sem `references`: pacote independente, nao depende de nenhum irmao. Vazio de
  // proposito.
  "references": [],
  "include": ["src/**/*.ts"],
  // Exclui testes do build: importam vitest/fast-check, que nao sao dependencia
  // do pacote e nao podem vazar para o dist publicado.
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/__bench__/**", "src/__tests__/**"]
}
