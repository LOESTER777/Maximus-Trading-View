{
  "name": "@robustus/charts-engine",
  "version": "0.1.0",
  "description": "Motor de grafico sem framework sobre @robustus/chart-core: expoe vocabulario proprio (linhas, series, marcadores, mapeador de coordenadas) e anexa camadas de canvas. Zero terceiros.",
  "license": "UNLICENSED",
  "author": "Loester Rodrigo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOESTER777/Maximus-Trading-View.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/**/__bench__/**",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@robustus/chart-core": "^0.1.0",
    "@robustus/charts-core": "^0.1.0",
    "@robustus/charts-primitives": "^0.1.0"
  }
}
