{
  "name": "@robustus/charts-engine",
  "version": "0.1.0",
  "description": "Motor de grafico sem framework sobre @robustus/chart-core: expoe vocabulario proprio (linhas, series, marcadores, mapeador de coordenadas) e anexa camadas de canvas. Zero terceiros.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@robustus/chart-core": "0.1.0",
    "@robustus/charts-core": "0.1.0",
    "@robustus/charts-primitives": "0.1.0"
  }
}
