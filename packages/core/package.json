{
  "name": "@robustus/charts-core",
  "version": "0.1.0",
  "description": "Nucleos PUROS de visualizacao de mercado: agregacao por zoom, escala de cor por percentil, celula->pixel, decodificacao colunar, cobertura, paredes, perfil de volume, footprint. Zero dependencia de runtime.",
  "license": "UNLICENSED",
  "author": "Loester Rodrigo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOESTER777/Maximus-Trading-View.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/**/__bench__/**",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "prepublishOnly": "npm run build"
  }
}
